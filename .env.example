# 36-character Zarinpal merchant ID (from your Zarinpal panel)
ZARINPAL_MERCHANT_ID=

# Default amount in rials for generated payment sessions
ZARINPAL_AMOUNT=10000

# Zarinpal may require the callback to be on your registered domain; override if localhost is rejected
# ZARINPAL_CALLBACK_URL=https://example.com/

# PORT=4321
# DATASET_DIR=datasets
